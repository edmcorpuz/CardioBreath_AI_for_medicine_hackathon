# Copy to .env.local (git ignores it) and fill in. Never commit the real value.
# Backend origin for the Netlify /api proxy, https and no path. On Netlify, set it in the site's
# environment variables instead. Not NEXT_PUBLIC_*: those values are baked into the public JavaScript.
API_ORIGIN=https://your-backend.example.azurecontainerapps.io
